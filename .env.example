# hypeAfnan environment template — copy to .env.local for local dev, and mirror into Vercel (Production + Preview)
# NEVER commit .env.local. Real values come from the owner's dashboards (roadmap decision D4).

# --- Sanity CMS ---
# (fallbacks exist in sanity/env.ts, but set real values to hit the real dataset)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-13

# --- Supabase (auth + avatars) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backblaze B2 (scripts/ upload pipeline only — never needed by the running app) ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=HypeAfnan-images
B2_ENDPOINT=
